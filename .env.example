# ==============================================================================
# PHOENIX Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

PROJECT_NAME="PHOENIX"
ENV="development" # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
# Generate a cryptographically strong secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="phoenix-prototype-secret-key-change-in-production-never-hardcode"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap Initial SuperAdmin (only created if no users exist in database)
PHOENIX_SUPERADMIN_EMAIL="admin@phoenix.local"
PHOENIX_SUPERADMIN_PASSWORD="ChangeMeInProduction123!"

# ------------------------------------------------------------------------------
# Database Persistence (SQLAlchemy 2.0 / Alembic)
# ------------------------------------------------------------------------------
# SQLite (Development / Standalone edge deployment):
DATABASE_URL="sqlite:///./phoenix.db"

# PostgreSQL (High-concurrency / Production deployment):
# DATABASE_URL="postgresql://phoenix_user:StrongPasswordHere@localhost:5432/phoenix"

# ------------------------------------------------------------------------------
# Media & Storage Paths
# ------------------------------------------------------------------------------
MEDIA_STORAGE_ROOT="./storage"

# ------------------------------------------------------------------------------
# Model Weights & Inference Configuration
# ------------------------------------------------------------------------------
YOLO_MODEL_PATH="./models/yolo11n.pt"
FIRE_SMOKE_MODEL_PATH="./models/fire_smoke_best.pt"
CONFIDENCE_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# Navigation & Graph Versioning
# ------------------------------------------------------------------------------
GRAPH_CONFIG_PATH="./configs/navigation_default.yaml"
